# Copy to .env and fill in, or export these directly.
# Option A -- connection string (simplest for local/demo use):
AZURE_EVENT_HUB_CONNECTION_STRING=
AZURE_EVENT_HUB_NAME=chocolate-telemetry

# Option B -- Azure CLI auth (leave connection string blank, run `az login` first):
# AZURE_EVENT_HUB_NAMESPACE_HOSTNAME=<namespace>.servicebus.windows.net
# AZURE_EVENT_HUB_NAME=chocolate-telemetry

# Optional simulator tuning:
SIMULATION_INTERVAL=5.0
ANOMALY_RATE=0.03
# MAX_RUNTIME_SECONDS=
