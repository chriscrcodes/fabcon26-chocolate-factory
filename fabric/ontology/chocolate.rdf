        <rdfs:label>LineId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/QualityCheck"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/chocolate-factory/quality_check_StageId">
        <rdfs:label>StageId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/QualityCheck"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/chocolate-factory/quality_check_Timestamp">
        <rdfs:label>Timestamp</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/QualityCheck"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <ont:propertyType>datetime</ont:propertyType>
