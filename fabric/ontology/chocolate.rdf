        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/chocolate-factory/factory_City">
        <rdfs:label>City</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/Factory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/chocolate-factory/factory_Country">
        <rdfs:label>Country</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/Factory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/chocolate-factory/factory_Region">
        <rdfs:label>Region</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/Factory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/chocolate-factory/factory_TimeZone">
        <rdfs:label>TimeZone</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/Factory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
