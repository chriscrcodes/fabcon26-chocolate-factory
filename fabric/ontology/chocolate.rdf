<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
    xml:base="http://example.org/ontology/chocolate-factory/"
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
    xmlns:ont="http://example.org/ontology/chocolate-factory/">

    <!-- Chocolate Factory -->
    <!-- Four chocolate factories (Barcelona, Chicago, São Paulo, Singapore), each running 2-3 production lines through the in-factory stages of chocolate making (grinding through packaging), plus the supply chain and ERP data around them. Farm Preparation (harvest, fermentation, drying, roasting, winnowing) happens near cocoa origin, upstream of these factories - see ../../CHOCOLATE-FACTORY.md - and is represented here only as incoming 'Cocoa Nibs' material from suppliers. -->

    <!-- Classes -->

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Factory">
        <rdfs:label>Factory</rdfs:label>
        <rdfs:comment>factory</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/ProductionLine">
        <rdfs:label>ProductionLine</rdfs:label>
        <rdfs:comment>production_line</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/ProductionStage">
        <rdfs:label>ProductionStage</rdfs:label>
        <rdfs:comment>production_stage</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Recipe">
        <rdfs:label>Recipe</rdfs:label>
        <rdfs:comment>recipe</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Batch">
        <rdfs:label>Batch</rdfs:label>
        <rdfs:comment>Materialized from bronze_batch_event (EventType: Started/Completed), streamed by the data generator at the first tick of grinding and the last tick of packaging -- not inferred from sensor_reading timing.</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/SensorReading">
        <rdfs:label>SensorReading</rdfs:label>
        <rdfs:comment>Streamed in real time from the data generator to Azure Event Hub -&gt; Fabric Eventstream -&gt; Eventhouse. One row per metric per tick (EAV shape) so new metrics never require a schema change.</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/QualityCheck">
        <rdfs:label>QualityCheck</rdfs:label>
        <rdfs:comment>quality_check</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/LineStatus">
        <rdfs:label>LineStatus</rdfs:label>
        <rdfs:comment>Streamed by the data generator on every Running&lt;-&gt;Down transition (state-change log, not a per-tick heartbeat). Status: Running or Down. Reason is set on Down rows only. Feeds Availability in gold_factory_oee_daily.</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Supplier">
        <rdfs:label>Supplier</rdfs:label>
        <rdfs:comment>supplier</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#2F6E63</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Material">
        <rdfs:label>Material</rdfs:label>
        <rdfs:comment>Type includes 'Cocoa Nibs' -- the output of the off-site Farm Preparation phase -- alongside Sugar, Milk, Packaging.</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#2F6E63</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Inventory">
        <rdfs:label>Inventory</rdfs:label>
        <rdfs:comment>inventory</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#2F6E63</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/BatchMaterialUsage">
        <rdfs:label>BatchMaterialUsage</rdfs:label>
        <rdfs:comment>Junction table closing the batch -&gt; material/supplier lot-traceability gap -- which material lots (and so which suppliers) fed a specific batch. BatchId is a loose, cross-plane reference to the Eventhouse's batch, same as shipment.BatchId, not a real FK.</rdfs:comment>
        <ont:icon>🏭</ont:icon>
        <ont:color>#A5522A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Shipment">
        <rdfs:label>Shipment</rdfs:label>
        <rdfs:comment>shipment</rdfs:comment>
        <ont:icon>🚚</ont:icon>
        <ont:color>#2F6E63</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Customer">
        <rdfs:label>Customer</rdfs:label>
        <rdfs:comment>customer</rdfs:comment>
        <ont:icon>🧾</ont:icon>
        <ont:color>#5B4B8A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Product">
        <rdfs:label>Product</rdfs:label>
        <rdfs:comment>product</rdfs:comment>
        <ont:icon>🧾</ont:icon>
        <ont:color>#5B4B8A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/SalesOrder">
        <rdfs:label>SalesOrder</rdfs:label>
        <rdfs:comment>sales_order</rdfs:comment>
        <ont:icon>🧾</ont:icon>
        <ont:color>#5B4B8A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/OrderLine">
        <rdfs:label>OrderLine</rdfs:label>
        <rdfs:comment>order_line</rdfs:comment>
        <ont:icon>🧾</ont:icon>
        <ont:color>#5B4B8A</ont:color>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/ontology/chocolate-factory/Invoice">
        <rdfs:label>Invoice</rdfs:label>
        <rdfs:comment>invoice</rdfs:comment>
        <ont:icon>🧾</ont:icon>
        <ont:color>#5B4B8A</ont:color>
    </owl:Class>

    <!-- Data Properties: Factory -->

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/chocolate-factory/factory_FactoryId">
        <rdfs:label>FactoryId</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/Factory"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <ont:propertyType>string</ont:propertyType>
        <ont:isIdentifier rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ont:isIdentifier>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://example.org/ontology/chocolate-factory/factory_Code">
        <rdfs:label>Code</rdfs:label>
        <rdfs:domain rdf:resource="http://example.org/ontology/chocolate-factory/Factory"/>
