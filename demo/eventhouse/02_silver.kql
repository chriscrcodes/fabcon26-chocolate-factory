// ---------------------------------------------------------------------
// silver_quality_check -- enriched with line, factory, and stage name
// ---------------------------------------------------------------------

.create table silver_quality_check (
    Timestamp: datetime, CheckId: string, BatchId: string,
    LineId: string, LineName: string, FactoryId: string, FactoryCode: string,
    StageId: string, StageName: string, Phase: string,
    DefectRate: real, Result: string, Notes: string
)
.create-or-alter function SilverQualityCheckTransform() {
    bronze_quality_check
    | extend Timestamp = todatetime(Timestamp)
    | invoke EnrichLine()
    | lookup kind=leftouter ref_production_stage on StageId
    | project-rename StageName = Name
    | project Timestamp, CheckId, BatchId, LineId, LineName, FactoryId, FactoryCode,
              StageId, StageName, Phase, DefectRate, Result, Notes
}
.alter table silver_quality_check policy update
@'[{"IsEnabled":true,"Source":"bronze_quality_check","Query":"SilverQualityCheckTransform()","IsTransactional":true,"PropagateIngestionProperties":false}]'

// ---------------------------------------------------------------------
// silver_line_status -- enriched with line + factory
// ---------------------------------------------------------------------

.create table silver_line_status (
    Timestamp: datetime, EventId: string,
    LineId: string, LineName: string, FactoryId: string, FactoryCode: string,
    Status: string, Reason: string
)
.create-or-alter function SilverLineStatusTransform() {
    bronze_line_status
    | extend Timestamp = todatetime(Timestamp)
    | invoke EnrichLine()
    | project Timestamp, EventId, LineId, LineName, FactoryId, FactoryCode, Status, Reason
}
.alter table silver_line_status policy update
@'[{"IsEnabled":true,"Source":"bronze_line_status","Query":"SilverLineStatusTransform()","IsTransactional":true,"PropagateIngestionProperties":false}]'

// ---------------------------------------------------------------------
// silver_batch -- the one true materialized view. Single source
// (bronze_batch_event), no join, so none of the streaming-ingestion or
// multi-source restrictions apply. StartTime/EndTime come straight from
// the Started/Completed lifecycle events -- no inference from readings.
//
// Status isn't computed here -- a materialized view's query can only be
// a table reference plus a single summarize operator, and only specific
// aggregation functions are allowed inside it (`iff` isn't one, even as
// an aggregation expression, verified against a live tenant). Consumers
// derive Status from EndTime instead (see gold_batch_summary in
// 03_gold.kql).
// ---------------------------------------------------------------------

.create materialized-view silver_batch on table bronze_batch_event
{
    bronze_batch_event
    | summarize
        LineId = take_any(LineId),
        RecipeId = take_any(RecipeId),
        StartTime = minif(todatetime(Timestamp), EventType == 'Started'),
        EndTime = maxif(todatetime(Timestamp), EventType == 'Completed')
      by BatchId
}
