// Silver: EAV sensor readings pivoted into per-stage wide tables, plus
// enriched quality checks and line status, plus the one true materialized
// view (silver_batch has a single, unjoined source -- bronze_batch_event).
// Run 01_bronze_and_reference.kql first.

// ---------------------------------------------------------------------
// Shared dimension lookup, reused by every table below
// ---------------------------------------------------------------------

.create-or-alter function EnrichLine(T: (LineId: string)) {
    T
    | lookup kind=leftouter ref_production_line on LineId
    | project-rename LineName = Name
    | lookup kind=leftouter ref_factory on FactoryId
    | project-rename FactoryCode = Code
}

// ---------------------------------------------------------------------
// Per-stage pivot tables (Factory Processing + Finishing, 6 total)
// Each one: filter bronze_sensor_reading to its StageId, pivot
// Metric/Value into named columns, enrich with line + factory.
//
// column_ifexists() wraps every pivoted metric column: update policies
// process one small ingestion batch/extent at a time, and if that batch
// happens to carry zero rows for a given stage, evaluate pivot() simply
// doesn't produce that stage's metric columns at all -- a plain
// `project Timestamp, ..., TemperatureC, ...` then fails with "Failed to
// resolve scalar expression named 'TemperatureC'", which (since these
// are IsTransactional policies) rolls back the *entire* ingestion batch,
// silently blocking Bronze itself from growing. Verified against a live
// tenant via `.show ingestion failures`.
// ---------------------------------------------------------------------

.create table silver_grinding (
    Timestamp: datetime, LineId: string, LineName: string, FactoryId: string, FactoryCode: string,
    StageId: string, BatchId: string,
    ParticleSizeMicron: real, MotorTemperatureC: real, ThroughputKgPerHr: real
)
.create-or-alter function SilverGrindingTransform() {
    bronze_sensor_reading
    | where StageId == 'grinding'
    | project LineId, StageId, BatchId, Timestamp = todatetime(Timestamp), Metric, Value
    | evaluate pivot(Metric, take_any(Value))
    | invoke EnrichLine()
    | project Timestamp, LineId, LineName, FactoryId, FactoryCode, StageId, BatchId,
              ParticleSizeMicron = column_ifexists('ParticleSizeMicron', real(null)),
              MotorTemperatureC = column_ifexists('MotorTemperatureC', real(null)),
              ThroughputKgPerHr = column_ifexists('ThroughputKgPerHr', real(null))
}
.alter table silver_grinding policy update
@'[{"IsEnabled":true,"Source":"bronze_sensor_reading","Query":"SilverGrindingTransform()","IsTransactional":true,"PropagateIngestionProperties":false}]'

