// Bronze + reference tables for the chocolate factory Eventhouse.
// Run this first, in a KQL queryset against the target KQL database.
//
// Bronze tables receive the four RecordType streams from
// demo/data-generation/src/simulator.py via Fabric Eventstream -- one
// Eventstream destination per RecordType, each mapped straight onto the
// matching table below with no transform.
//
// Reference tables are loaded once from demo/ontology/tables/*.csv as
// NATIVE ingested tables (e.g. a Fabric pipeline Copy activity, or
// `.ingest inline`/LightIngest) -- never as a OneLake shortcut. Kusto
// treats shortcuts as external tables, and neither a materialized view
// nor a joining update policy can be built over an external table.
// See the "Reality check" section of the medallion-layers design memo.

// ---------------------------------------------------------------------
// Bronze
// ---------------------------------------------------------------------

.create table bronze_sensor_reading (
    ReadingId: string,
    LineId: string,
    StageId: string,
    BatchId: string,
    Timestamp: datetime,
    Metric: string,
    Value: real,
    Unit: string
)

.create table bronze_quality_check (
    CheckId: string,
    BatchId: string,
    LineId: string,
    StageId: string,
    Timestamp: datetime,
    DefectRate: real,
    Result: string,
    Notes: string
)

.create table bronze_batch_event (
    EventId: string,
    BatchId: string,
    LineId: string,
    RecipeId: string,
    EventType: string,   // 'Started' | 'Completed'
    Timestamp: datetime
)

.create table bronze_line_status (
    EventId: string,
    LineId: string,
    Status: string,   // 'Running' | 'Down'
    Reason: string,
    Timestamp: datetime
)

// Every Silver update policy below that joins in dimension data needs its
// source table's streaming ingestion policy disabled -- Fabric Eventhouses
// enable it by default, and "to use functions with the join operator in an
// update policy, the streaming ingestion policy must be disabled"
// (Kusto update policy docs). bronze_batch_event is the one exception: its
// only downstream consumer (silver_batch) is a materialized view with no
// join, so it keeps the default streaming ingestion policy.
.alter table bronze_sensor_reading policy streamingingestion disable
.alter table bronze_quality_check policy streamingingestion disable
.alter table bronze_line_status policy streamingingestion disable

// ---------------------------------------------------------------------
// Reference (native copies, loaded once from demo/ontology/tables/*.csv)
// ---------------------------------------------------------------------

.create table ref_factory (
    FactoryId: string,
    Code: string,
    City: string,
    Country: string,
    Region: string,
    TimeZone: string
)

.create table ref_production_line (
    LineId: string,
    FactoryId: string,
    LineNumber: int,
    Name: string
)

.create table ref_production_stage (
    StageId: string,
    Phase: string,
    Name: string,
    SequenceOrder: int
)

.create table ref_recipe (
    RecipeId: string,
    Name: string,
    CacaoPercent: real,
    MilkPercent: real,
    SugarPercent: real
)

// Example one-off load for local/dev use (small tables -- a handful of
// rows each). For a real deployment, use a Fabric pipeline Copy activity
// against demo/ontology/tables/*.csv instead.
//
// .ingest inline into table ref_production_stage <|
//     grinding,Factory Processing,Grinding,1
//     mixing_refining,Factory Processing,Mixing & Refining,2
//     conching,Factory Processing,Conching,3
//     tempering,Finishing,Tempering,4
//     molding_cooling,Finishing,Molding & Cooling,5
//     packaging,Finishing,Packaging,6
